{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CrystalxSLY/beydosh-updates/main/schemas/latest.beydosh.schema.json",
  "title": "Beydosh signed stable index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Payload",
    "KeyId",
    "SignatureBase64"
  ],
  "properties": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Version",
        "ManifestSha256",
        "ManifestUrl",
        "CreatedAtUtc",
        "Commit",
        "KeyId"
      ],
      "properties": {
        "Version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "ManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "ManifestUrl": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/CrystalxSLY/beydosh-updates/[0-9a-f]{40}/updates/stable/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)/manifest\\.beydosh\\.json$"
        },
        "CreatedAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "Commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "KeyId": {
          "$ref": "#/$defs/keyId"
        }
      }
    },
    "KeyId": {
      "$ref": "#/$defs/keyId"
    },
    "SignatureBase64": {
      "type": "string",
      "minLength": 80,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
